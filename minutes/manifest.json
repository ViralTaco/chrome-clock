{
  "manifest_version": 3,
  "name": "Clock: Minutes",
  "version": "1.0.0",
  "description": "Displays the current minute in the extension toolbar icon using OffscreenCanvas.",
  "author": "viraltaco_ <https://anth.pro>",
  "homepage_url": "https://viraltaco.com/chrome-clock",
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Minutes Clock Icon"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
